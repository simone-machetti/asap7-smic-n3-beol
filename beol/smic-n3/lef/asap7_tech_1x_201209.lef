LAYER M11
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
 PITCH 0.148 0.148 ;
 WIDTH 0.074 ;
 AREA 0.02574 ;

  SPACINGTABLE
 PARALLELRUNLENGTH 0.0 0.73975 2.21975 3.32975
 WIDTH 0.0 0.074 0.074 0.074 0.074
 WIDTH 0.11075 0.074 0.074 0.074 0.074
 WIDTH 0.14775 0.074 0.074 0.074 0.074
 WIDTH 0.22175 0.074 0.074 0.074 0.074
 WIDTH 0.92475 0.074 0.074 0.074 0.925
 WIDTH 1.84975 0.074 0.074 0.074 1.85 ;

 MINIMUMCUT 2 WIDTH 3.339 WITHIN 3.154 FROMBELOW ;
 MINIMUMCUT 2 WIDTH 3.339 WITHIN 3.154 FROMABOVE ;
 MAXWIDTH 3.7 ;
 MINSTEP 0.074 STEP ;
END M11

# smic-n3: the Pad layer and its cut are ASAP7's, moved above M11. Nothing in the
# flow routes on them. SMIC's two package-scale layers above M11 are left out.

LAYER V11
  TYPE CUT ;
 SPACING 0.057 ;
 WIDTH 0.04 ;
END V11

LAYER Pad
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
 PITCH 0.08 0.08 ;
 WIDTH 0.04 ;
  SPACINGTABLE
 PARALLELRUNLENGTH 0.0 11.99975
 WIDTH 0.0 2.0 2.0
 WIDTH 11.99975 2.0 3.0 ;
 MINIMUMCUT 1 WIDTH 0.04 WITHIN 1.705 FROMBELOW ;
 MINIMUMCUT 1 WIDTH 0.36 WITHIN 1.705 FROMBELOW ;
 MINIMUMCUT 2 WIDTH 1.805 WITHIN 1.705 FROMBELOW ;
 MINIMUMDENSITY 20.0 ;
 MAXIMUMDENSITY 80.0 ;
 DENSITYCHECKWINDOW 100.0 100.0 ;
 DENSITYCHECKSTEP 50.0 ;
END Pad

# vias
#
# smic-n3: one fixed via per adjacent pair, used as the router's default cut.
# On the coarse layers the metal is a square of the wire width around the cut,
# as in ASAP7's VIA89. On M3 the enclosure runs 5 nm past the cut along the wire,
# as in ASAP7's VIA23 and VIA34.

VIA VIA11Pad Default
  LAYER M11 ;
 RECT -0.05 -0.05 0.05 0.05 ;
  LAYER Pad ;
 RECT -0.05 -0.05 0.05 0.05 ;
  LAYER V11 ;
 RECT -0.05 -0.05 0.05 0.05 ;
END VIA11Pad

VIA VIA1011 Default
  LAYER M10 ;
 RECT -0.032 -0.032 0.032 0.032 ;
  LAYER M11 ;
 RECT -0.037 -0.037 0.037 0.037 ;
  LAYER V10 ;
 RECT -0.032 -0.032 0.032 0.032 ;
END VIA1011

VIA VIA910 Default
  LAYER M9 ;
 RECT -0.032 -0.032 0.032 0.032 ;
  LAYER M10 ;
 RECT -0.032 -0.032 0.032 0.032 ;
  LAYER V9 ;
 RECT -0.032 -0.032 0.032 0.032 ;
END VIA910

VIA VIA89 Default
  LAYER M8 ;
 RECT -0.032 -0.032 0.032 0.032 ;
  LAYER M9 ;
 RECT -0.032 -0.032 0.032 0.032 ;
  LAYER V8 ;
 RECT -0.032 -0.032 0.032 0.032 ;
END VIA89

VIA VIA78 Default
  LAYER M7 ;
 RECT -0.032 -0.032 0.032 0.032 ;
  LAYER M8 ;
 RECT -0.032 -0.032 0.032 0.032 ;
  LAYER V7 ;
 RECT -0.032 -0.032 0.032 0.032 ;
END VIA78

VIA VIA67 Default
  LAYER M6 ;
 RECT -0.02 -0.02 0.02 0.02 ;
  LAYER M7 ;
 RECT -0.032 -0.032 0.032 0.032 ;
  LAYER V6 ;
 RECT -0.02 -0.02 0.02 0.02 ;
END VIA67

VIA VIA56 Default
