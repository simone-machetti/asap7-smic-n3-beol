END VIA45

VIA VIA34 Default
  LAYER M3 ;
 RECT -0.011 -0.016 0.011 0.016 ;
  LAYER M4 ;
 RECT -0.02 -0.02 0.02 0.02 ;
  LAYER V3 ;
 RECT -0.011 -0.011 0.011 0.011 ;
END VIA34

VIA VIA23 Default
  LAYER M2 ;
 RECT -0.014 -0.009 0.014 0.009 ;
  LAYER M3 ;
 RECT -0.011 -0.014 0.011 0.014 ;
  LAYER V2 ;
