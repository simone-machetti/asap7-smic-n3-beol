 WIDTH 0.0 0.064 0.064 0.064 0.064
 WIDTH 0.09575 0.064 0.064 0.064 0.064
 WIDTH 0.12775 0.064 0.064 0.064 0.064
 WIDTH 0.19175 0.064 0.064 0.064 0.064
 WIDTH 0.79975 0.064 0.064 0.064 0.8
 WIDTH 1.59975 0.064 0.064 0.064 1.6 ;

 MINIMUMCUT 2 WIDTH 2.888 WITHIN 2.728 FROMBELOW ;
 MINIMUMCUT 2 WIDTH 2.888 WITHIN 2.728 FROMABOVE ;
