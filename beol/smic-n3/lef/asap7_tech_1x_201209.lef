END VIA23

VIA VIA12 Default
  LAYER M1 ;
 RECT -0.009 -0.011 0.009 0.011 ;
  LAYER M2 ;
 RECT -0.014 -0.009 0.014 0.009 ;
  LAYER V1 ;
 RECT -0.009 -0.009 0.009 0.009 ;
END VIA12

#################################
### VIARULE GENERATE DEFAULTS ###
#################################
#
# smic-n3: one generate rule per adjacent pair of coarse layers, which is what the
# power grid builds its via arrays from. SPACING is centre to centre: the cut
# plus the cut-layer spacing. Between M2 and M3 the arrays are built from the
# fixed via above, as in ASAP7. ASAP7's wide power rules are dropped, since they
# are tied to its strap widths.

VIARULE Pad_M11 GENERATE DEFAULT
  LAYER M11 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER Pad ;
 ENCLOSURE 0.011 0.0 ;
  LAYER V11 ;
 RECT -0.02 -0.02 0.02 0.02 ;
 SPACING 0.097 BY 0.097 ;
END Pad_M11

VIARULE M11_M10 GENERATE DEFAULT
  LAYER M10 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER M11 ;
 ENCLOSURE 0.005 0.005 ;
  LAYER V10 ;
 RECT -0.032 -0.032 0.032 0.032 ;
 SPACING 0.156 BY 0.156 ;
END M11_M10

VIARULE M10_M9 GENERATE DEFAULT
  LAYER M9 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER M10 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER V9 ;
 RECT -0.032 -0.032 0.032 0.032 ;
 SPACING 0.156 BY 0.156 ;
END M10_M9

VIARULE M9_M8 GENERATE DEFAULT
  LAYER M8 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER M9 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER V8 ;
 RECT -0.032 -0.032 0.032 0.032 ;
 SPACING 0.156 BY 0.156 ;
END M9_M8

VIARULE M8_M7 GENERATE DEFAULT
  LAYER M7 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER M8 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER V7 ;
 RECT -0.032 -0.032 0.032 0.032 ;
 SPACING 0.156 BY 0.156 ;
END M8_M7

VIARULE M7_M6 GENERATE DEFAULT
  LAYER M6 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER M7 ;
 ENCLOSURE 0.012 0.012 ;
  LAYER V6 ;
 RECT -0.02 -0.02 0.02 0.02 ;
 SPACING 0.097 BY 0.097 ;
END M7_M6

VIARULE M6_M5 GENERATE DEFAULT
  LAYER M5 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER M6 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER V5 ;
 RECT -0.02 -0.02 0.02 0.02 ;
 SPACING 0.097 BY 0.097 ;
END M6_M5

VIARULE M5_M4 GENERATE DEFAULT
  LAYER M4 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER M5 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER V4 ;
 RECT -0.02 -0.02 0.02 0.02 ;
 SPACING 0.097 BY 0.097 ;
END M5_M4

# M3 to M4: M3 runs 5 nm past the cut along the wire, as ASAP7's V3 asks of M3,
# and M4 covers the cut with its full width. The power grid also sizes the M3
# patch of a via stack through M3 from this enclosure.

VIARULE M4_M3 GENERATE DEFAULT
  LAYER M3 ;
 ENCLOSURE 0.0 0.005 ;
  LAYER M4 ;
 ENCLOSURE 0.009 0.009 ;
  LAYER V3 ;
 RECT -0.011 -0.011 0.011 0.011 ;
 SPACING 0.054 BY 0.054 ;
END M4_M3

VIARULE M2_M1 GENERATE DEFAULT
  LAYER M1 ;
 ENCLOSURE 0.0 0.0 ;
  LAYER M2 ;
 ENCLOSURE 0.002 0.0 ;
  LAYER V1 ;
 RECT -0.009 -0.009 0.009 0.009 ;
 SPACING 0.036 BY 0.036 ;
END M2_M1

END LIBRARY
